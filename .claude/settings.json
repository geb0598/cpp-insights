{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git ls-files:*)",
      "Bash(./build/debug/Debug/insights-test.exe:*)",
      "Bash(./build/release/Release/insights-test.exe:*)"
    ]
  }
}
